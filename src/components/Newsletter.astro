---
interface Props {
  lang?: "en" | "ar";
}

const { lang = "en" } = Astro.props;
const isAr = lang === "ar";
---

<section
  class="newsletter-section"
  aria-label={isAr ? "النشرة البريدية" : "Newsletter signup"}
  dir={isAr ? "rtl" : "ltr"}
>
  <div class="newsletter-container">
    <h3 class="newsletter-title">
      {isAr ? "اشترك في نشرتنا البريدية" : "Subscribe to Our Newsletter"}
    </h3>
    <p class="newsletter-desc">
      {isAr
        ? "احصل على أحدث أدلة الأزياء ونصائح الأناقة مباشرة في بريدك الوارد"
        : "Get the latest style guides and fashion tips delivered to your inbox"}
    </p>
    <form class="newsletter-form" action="https://formsubmit.co/mn.oun93@gmail.com" method="POST">
      <input type="hidden" name="_subject" value="New Askoutfit subscriber" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://www.askoutfit.com/?subscribed=1" />
      <input
        type="email"
        name="email"
        placeholder={isAr ? "بريدك الإلكتروني" : "Your email address"}
        required
        class="newsletter-input"
        aria-label={isAr ? "بريدك الإلكتروني" : "Your email address"}
      />
      <button type="submit" class="newsletter-btn">
        {isAr ? "اشترك الآن" : "Subscribe Now"}
      </button>
    </form>
    <p class="newsletter-note">
      {isAr ? "نحترم خصوصيتك. لا سبام أبداً." : "We respect your privacy. No spam ever."}
    </p>
  </div>
</section>

<style>
  .newsletter-section {
    margin: 44px 0;
    padding: 32px 20px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.04) 100%);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 16px;
  }
  .newsletter-container { max-width: 500px; margin: 0 auto; text-align: center; }
  .newsletter-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.5rem;
    color: var(--ink, #f3ece2);
    margin: 0 0 8px;
  }
  [dir="rtl"] .newsletter-title { font-family: "Tajawal", "Playfair Display", sans-serif; }
  .newsletter-desc { color: var(--muted, #b9ad9b); font-size: 0.9rem; margin: 0 0 20px; }
  .newsletter-form { display: flex; gap: 12px; max-width: 400px; margin: 0 auto; }
  .newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    background: var(--surface, #221b14);
    border: 1px solid var(--line, #3a3026);
    border-radius: 8px;
    color: var(--ink, #f3ece2);
    font-family: inherit;
    font-size: 0.9rem;
  }
  .newsletter-input:focus { outline: 2px solid var(--gold, #caa46a); outline-offset: 2px; }
  .newsletter-btn {
    padding: 12px 24px;
    background: linear-gradient(135deg, #d4af37 0%, #caa46a 100%);
    color: #15110c;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
  }
  .newsletter-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(212, 175, 55, 0.4);
  }
  .newsletter-note { font-size: 0.75rem; color: var(--faint, #6b6052); margin: 12px 0 0; }
  @media (max-width: 480px) {
    .newsletter-form { flex-direction: column; }
    .newsletter-btn { width: 100%; }
  }
</style>
