---
/**
 * ShopTheLook.astro — مكون تسوق الإطلالة الذكي
 */
interface Props {
  shopItems: string[];
  shopLabels: string[];
  amz: (term: string) => string;
  occasion?: string;
  season?: string;
  lang: 'en' | 'ar';
  dir: 'ltr' | 'rtl';
  schema?: boolean;
}

const {
  shopItems,
  shopLabels,
  amz,
  occasion = '',
  season = '',
  lang = 'en',
  dir = 'ltr',
  schema = true,
} = Astro.props;

const isAr = lang === 'ar';

const sectionTitle = isAr ? 'تسوق الإطلالة' : 'Shop the Look';
const sectionSubtitle = isAr
  ? 'ابحث عن القطع الأساسية لهذه الإطلالة على أمازون — روابط الأفلييت تدعم الموقع مجاناً'
  : 'Find the key pieces for this look on Amazon — affiliate links keep this site free';

const ctaText = isAr ? 'عرض على أمازون' : 'View on Amazon';

// ENHANCED
const productSchemas = shopItems.map((term, i) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': shopLabels[i] || term,
  'description': 'Recommended for ' + (occasion || 'this occasion') + (season ? ' in ' + season : ''),
  'offers': {
    '@type': 'Offer',
    'url': amz(term),
    'priceCurrency': 'USD',
    'availability': 'https://schema.org/InStock',
    'seller': { '@type': 'Organization', 'name': 'Amazon' }
  }
}));

// Determine badge for each item (first = Best Seller, second = Editor's Pick)
function getBadge(index: number, label: string, isAr: boolean): string | null {
  if (index === 0) return isAr ? 'الأكثر مبيعاً' : 'Best Seller';
  if (index === 1) return isAr ? 'اختيار المحرر' : 'Editor\'s Pick';
  return null;
}

// Smart SVG Icons for each fashion category (Luxury Gold #d4af37)
function getCategoryIcon(label: string): string {
  const text = label.toLowerCase();
  
  // Coat / Parka / Jacket / Blazer / معطف / جاكيت / بليزر
  if (text.match(/\b(coat|parka|jacket|blazer|trench|peacoat|puffer|down|bomber|field\s+jacket|leather\s+jacket|denim\s+jacket|wool\s+coat|cashmere\s+coat|overcoat|topcoat|car\s+coat|معطف|جاكيت|بليزر|ترنش|باركا|بوفر)\b/)) {
    return `<svg class="stl-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 3h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
      <path d="M6 9h16"/>
      <path d="M10 13v6"/>
      <path d="M14 13v6"/>
      <circle cx="10" cy="17" r="1"/>
      <circle cx="14" cy="17" r="1"/>
      <path d="M8 9v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V9"/>
    </svg>`;
  }
  
  // Suit / Tuxedo / بدلة
  if (text.match(/\b(suit|tuxedo|tux|formal\s+suit|business\s+suit|wedding\s+suit|بدلة|توكسيدو)\b/)) {
    return `<svg class="stl-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 3h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
      <path d="M6 9h16"/>
      <path d="M10 13v6"/>
      <path d="M14 13v6"/>
      <path d="M8 5v4M16 5v4"/>
      <path d="M12 3v3M12 21v-3"/>
      <path d="M8 15h8"/>
      <path d="M10 9v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V9"/>
      <path d="M12 7v2" stroke-width="2"/>
      <ellipse cx="12" cy="5" rx="1.5" ry="1" transform="rotate(-20 12 5)"/>
    </svg>`;
  }
  
  // Default: generic luxury item icon
  return `<svg class="stl-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3"/>
    <path d="M21 16V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3"/>
    <path d="M4 8h16M4 16h16"/>
    <path d="M10 8v8M14 8v8"/>
    <circle cx="12" cy="12" r="2"/>
  </svg>`;
}

// Build "Complete the Look" search URL with all items
const completeLookTerms = shopItems.slice(0, 5).join('+');
const completeLookUrl = `https://www.amazon.com/s?k=${encodeURIComponent(completeLookTerms)}&tag=askoutfit-20`;
const completeLookText = isAr 
  ? 'احصل على الإطلالة الكاملة' 
  : 'Complete the Full Look';
const completeLookDesc = isAr
  ? 'تنسيق هذه القطع معاً يمنحك إطلالة متكاملة ومتناسقة — وفر وقت البحث واشتري الطقم كاملاً بنقرة واحدة.'
  : 'Styling these pieces together gives you a complete, cohesive look — save search time and buy the full ensemble in one click.';
const completeLookCta = isAr ? 'تسوق الطقم الكامل على أمازون' : 'Shop Complete Look on Amazon';
---

{shopItems.length > 0 && (
  <section class="shop-the-look" id="shop-the-look" data-lang={lang} data-dir={dir}>
    <header class="stl-header">
      <h2 class="stl-title">{sectionTitle}</h2>
      <p class="stl-subtitle">{sectionSubtitle}</p>
    </header>

    <div class="stl-grid" role="list" aria-label={sectionTitle}>
      {shopItems.map((term, i) => {
        const label = shopLabels[i] || term;
        const badge = getBadge(i, label, isAr);
        const icon = getCategoryIcon(label);
        
        return (
          <article class="stl-card" role="listitem" data-index={i}>
            {badge && (
              <span class="stl-badge">{badge}</span>
            )}
            <div class="stl-media">
              {icon ? (
                <span class="stl-icon" set:html={icon} />
              ) : (
                <span class="stl-icon-fallback" aria-hidden="true">🛍️</span>
              )}
            </div>
            <div class="stl-content">
              <h3 class="stl-name">{label}</h3>
              <a href={amz(term)} target="_blank" rel="noopener nofollow sponsored" class="stl-cta" data-cta="shop-the-look" data-item={term}>
                <span>{ctaText}</span>
                <svg class="stl-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        )
      })}
    </div>

    <!-- Complete the Full Look CTA Box -->
    <div class="stl-complete-look" role="region" aria-label={completeLookText}>
      <div class="stl-complete-content">
        <div class="stl-complete-icon" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block; width:64px; height:64px;">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </div>
        <div class="stl-complete-text">
          <h3>{completeLookText}</h3>
          <p>{completeLookDesc}</p>
        </div>
        <a href={completeLookUrl} target="_blank" rel="noopener nofollow sponsored" class="stl-complete-cta" data-cta="complete-the-look">
          <span>{completeLookCta}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    {schema && (<>{productSchemas.map((s, i) => (<script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />))}</>)}
  </section>
)}

<style>
  .shop-the-look {
    --stl-gold: #caa46a;
    --stl-gold-light: #d8b67e;
    --stl-surface: #221b14;
    --stl-bg: #1a1410;
    --stl-line: #3a3026;
    --stl-ink: #f3ece2;
    --stl-muted: #b9ad9b;
    --stl-faint: #6b6052;
    --stl-radius: 14px;
    --stl-transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--stl-line);
  }

  .stl-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .stl-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--stl-ink);
    margin: 0 0 6px;
  }

  [dir="rtl"] .stl-title {
    font-family: 'Tajawal', 'Playfair Display', sans-serif;
    font-weight: 700;
  }

  .stl-subtitle {
    color: var(--stl-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .stl-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 480px) {
    .stl-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 768px) {
    .stl-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .stl-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--stl-surface);
    border: 1px solid var(--stl-line);
    border-radius: var(--stl-radius);
    overflow: hidden;
    transition: var(--stl-transition);
  }

  .stl-card:hover {
    border-color: var(--stl-gold);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .stl-media {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(202,164,106,0.15) 0%, rgba(202,164,106,0.08) 100%);
    min-height: 120px;
  }

  .stl-icon {
    font-size: 3rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .stl-icon-fallback {
    font-size: 3rem;
    line-height: 1;
    opacity: 0.6;
  }

  .stl-content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .stl-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--stl-ink);
    margin: 0;
    line-height: 1.3;
  }

  [dir="rtl"] .stl-name {
    font-family: 'Tajawal', 'Playfair Display', sans-serif;
    font-weight: 700;
  }

  .stl-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    background: var(--stl-gold);
    color: var(--stl-bg);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: var(--stl-transition);
    border: none;
    cursor: pointer;
    margin-top: auto;
  }

  .stl-cta:hover {
    background: var(--stl-gold-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(202, 164, 106, 0.35);
  }

  .stl-cta:active {
    transform: translateY(0);
  }

  .stl-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: var(--stl-transition);
  }

  .stl-cta:hover .stl-arrow {
    transform: translateX(2px);
  }

  [dir="rtl"] .stl-cta:hover .stl-arrow {
    transform: translateX(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-the-look * { transition: none !important; animation: none !important; }
  }

  /* Badge Styles */
  .stl-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    padding: 4px 10px;
    background: linear-gradient(135deg, #d4af37 0%, #caa46a 100%);
    color: var(--stl-bg);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.4);
    font-family: 'Tajawal', 'Playfair Display', sans-serif;
  }

  [dir="rtl"] .stl-badge {
    right: auto;
    left: 10px;
  }

  .stl-media {
    position: relative;
  }

  .stl-svg-icon {
    width: 70%;
    height: 70%;
    max-width: 96px;
    max-height: 96px;
    filter: drop-shadow(0 4px 12px rgba(212, 175, 55, 0.25));
    transition: var(--stl-transition);
    stroke: #d4af37;
  }

  .stl-complete-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stl-card:hover .stl-svg-icon {
    transform: scale(1.05);
    filter: drop-shadow(0 6px 16px rgba(212, 175, 55, 0.4));
  }
</style>