---
// Base layout — holds GA4, fonts, and shared <head> SEO for ALL pages.
// One place for the tracking code; every page inherits it.
import "../styles/global.css";
export interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: "ltr" | "rtl";
  canonical?: string;
  ogImage?: string;
  altLang?: string;
  altUrl?: string;
  // hreflang 쌍 (اختياري - للصفحات العربية/الإنجليزية المترابطة)
  hreflangPairs?: Array<{ lang: string; url: string }>;
  // Disable fallback Article JSON-LD (for pages that provide their own)
  disableArticleJsonLd?: boolean;
}
const {
  title,
  description = "AI stylist: describe the occasion, get a complete shoppable outfit in seconds.",
  lang = "en",
  dir = "ltr",
  canonical,
  ogImage = "https://askoutfit.com/og-default.jpg",
  altLang,
  altUrl,
  hreflangPairs = [],
  disableArticleJsonLd = false,
} = Astro.props;

// تأكد من تراكب Slash في canonical
function ensureTrailingSlash(url: string): string {
  return url.endsWith("/") ? url : url + "/";
}

const canonicalUrl = ensureTrailingSlash(canonical ?? new URL(Astro.url.pathname, Astro.site).href);

// بناء أزواج hreflang من hreflangPairs + altLang/altUrl + self + x-default
function buildHreflangLinks() {
  const links: Array<{ lang: string; url: string }> = [
    { lang, url: canonicalUrl },
    { lang: "x-default", url: canonicalUrl },
  ];
  
  if (altLang && altUrl) {
    links.push({ lang: altLang, url: ensureTrailingSlash(altUrl) });
  }
  
  hreflangPairs.forEach(p => {
    if (!links.some(l => l.lang === p.lang)) {
      links.push({ lang: p.lang, url: ensureTrailingSlash(p.url) });
    }
  });
  
  // إزالة التكرارات (نفس اللغة)
  const seen = new Set<string>();
  return links.filter(l => {
    if (seen.has(l.lang)) return false;
    seen.add(l.lang);
    return true;
  });
}

const hreflangLinks = buildHreflangLinks();
const isAr = lang === 'ar';

// Compute SEO-optimized title (max 60 chars, no | Askoutfit)
// Use 55 as safety margin for HTML entity expansion (& -> &, etc.)
const seoTitle = title.length > 55 ? title.slice(0, 52) + "..." : title;

// Compute SEO-optimized description (120-155 chars)
let seoDesc = description ?? "AI stylist: describe the occasion, get a complete shoppable outfit in seconds.";
if (seoDesc.length < 120) {
  seoDesc += " Discover personalized outfit recommendations for any occasion instantly with Askoutfit AI stylist.";
}
if (seoDesc.length > 155) {
  seoDesc = seoDesc.slice(0, 152) + "...";
}
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href={canonicalUrl} />

    {/* hreflang — من مصدر واحد فقط (Base.astro) */}
    {hreflangLinks.map(l => (
      <link rel="alternate" hreflang={l.lang} href={l.url} />
    ))}

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Askoutfit" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&family=Tajawal:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {/* Google tag (gtag.js) — fires on every page */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-FNPXSJF5RN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FNPXSJF5RN");
    </script>

    <!-- Favicon & Brand Assets -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="preload" as="image" href="/logo.svg" />
    <link rel="preload" as="image" href="/og-default.jpg" />
    <slot name="head" />
  
  {/* JSON-LD: Organization (دائماً) */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Askoutfit",
    "url": "https://askoutfit.com/",
    "logo": "https://askoutfit.com/logo.svg",
    "sameAs": [
      "https://twitter.com/askoutfit",
      "https://instagram.com/askoutfit"
    ]
  })} />
  {/* JSON-LD: Article (Fallback - used when page does not provide its own) */}
  {!disableArticleJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": ogImage,
      "datePublished": new Date().toISOString().split("T")[0],
      "author": {
        "@type": "Organization",
        "name": "Askoutfit"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Askoutfit",
        "logo": {
          "@type": "ImageObject",
          "url": "https://askoutfit.com/logo.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      }
    })} />
  )}
  </head>
  <body>
    <slot />
  
    <!-- Newsletter Form - Connected to n8n Webhook -->
    <section class="newsletter-section" aria-label="Newsletter signup">
      <div class="newsletter-container">
        <h3 class="newsletter-title">
          {isAr ? 'اشترك في نشرتنا البريدية' : 'Subscribe to Our Newsletter'}
        </h3>
        <p class="newsletter-desc">
          {isAr ? 'احصل على أحدث أدلة الأزياء ونصائح الأناقة مباشرة في بريدك الوارد' : 'Get the latest style guides and fashion tips delivered to your inbox'}
        </p>
        <form class="newsletter-form" action="https://your-n8n-domain.com/webhook/newsletter" method="POST" target="_blank">
          <input 
            type="email" 
            name="email" 
            placeholder={isAr ? 'بريدك الإلكتروني' : 'Your email address'} 
            required 
            class="newsletter-input"
            aria-label={isAr ? 'بريدك الإلكتروني' : 'Your email address'}
          />
          <button type="submit" class="newsletter-btn">
            {isAr ? 'اشترك الآن' : 'Subscribe Now'}
          </button>
        </form>
        <p class="newsletter-note">
          {isAr ? 'نحترم خصوصيتك. لا سبام أبداً.' : 'We respect your privacy. No spam ever.'}
        </p>
      </div>
    </section>
    
    <style>
      .newsletter-section {
        margin-top: 48px;
        padding: 32px 20px;
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.04) 100%);
        border: 1px solid rgba(212, 175, 55, 0.2);
        border-radius: 16px;
      }
      .newsletter-container { max-width: 500px; margin: 0 auto; text-align: center; }
      .newsletter-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem;
        color: var(--ink);
        margin: 0 0 8px;
      }
      [dir="rtl"] .newsletter-title { font-family: 'Tajawal', 'Playfair Display', sans-serif; }
      .newsletter-desc { color: var(--muted); font-size: 0.9rem; margin: 0 0 20px; }
      .newsletter-form { display: flex; gap: 12px; max-width: 400px; margin: 0 auto; }
      .newsletter-input {
        flex: 1;
        padding: 12px 16px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--ink);
        font-family: inherit;
        font-size: 0.9rem;
      }
      .newsletter-input:focus { outline: 2px solid var(--gold); outline-offset: 2px; }
      .newsletter-btn {
        padding: 12px 24px;
        background: linear-gradient(135deg, #d4af37 0%, #caa46a 100%);
        color: var(--bg);
        font-weight: 600;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.25s;
        white-space: nowrap;
      }
      .newsletter-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(212, 175, 55, 0.4);
      }
      .newsletter-note { font-size: 0.75rem; color: var(--faint); margin: 12px 0 0; }
      @media (max-width: 480px) {
        .newsletter-form { flex-direction: column; }
        .newsletter-btn { width: 100%; }
      }
    </style>
    
  </body>
</html>

<style is:global>
  :root {
    --bg: #1a1410;
    --surface: #221b14;
    --line: #3a3026;
    --ink: #f3ece2;
    --muted: #b9ad9b;
    --faint: #6b6052;
    --gold: #caa46a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Inter", system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  html[dir="rtl"] body { font-family: "Tajawal", "Inter", sans-serif; }
  a { color: var(--gold); }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; animation: none !important; }
  }
</style>
